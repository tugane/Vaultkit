{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.ts": { "maxDuration": 15 }
  },
  "headers": [
    {
      "source": "/v1/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ],
  "rewrites": [
    { "source": "/v1/activate", "destination": "/api/v1/activate" },
    { "source": "/v1/validate", "destination": "/api/v1/validate" },
    { "source": "/v1/deactivate", "destination": "/api/v1/deactivate" }
  ]
}
