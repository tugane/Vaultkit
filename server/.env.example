# Stripe. Use the test keys until the whole flow works end to end.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# The recurring yearly price you created in the Stripe dashboard.
STRIPE_PRICE_ID=price_...

# Ed25519 signing key, PKCS#8 PEM, base64-encoded. Printed by `npm run keygen`,
# together with the public half that belongs in Licensing.signingPublicKey.
# This is the one secret that matters: anyone holding it can mint licences.
LICENCE_SIGNING_KEY=

# Upstash Redis (Vercel → Storage → Redis gives you both of these).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: emailing the key on purchase. Without it the key is still shown on
# the success page, and written to the function log.
RESEND_API_KEY=
LICENCE_FROM_EMAIL=Vaultkit <licences@vaultkit.app>

# Where Stripe sends people afterwards.
SITE_URL=https://vaultkit.app
